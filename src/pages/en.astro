---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import FeaturesGrid from '../components/FeaturesGrid.astro';
import Screenshots from '../components/Screenshots.astro';
import ArchitectureSection from '../components/ArchitectureSection.astro';
import FileStorage from '../components/FileStorage.astro';
import DeployMethods from '../components/DeployMethods.astro';
import SqlMigrationsSection from '../components/SqlMigrationsSection.astro';
import ApiReference from '../components/ApiReference.astro';
import ConfigSecrets from '../components/ConfigSecrets.astro';
import DownloadCta from '../components/DownloadCta.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Markflare — Self-hosted block notes on Cloudflare Pages + D1"
  description="A self-hosted, block-based note-taking workspace on Cloudflare Pages + D1 SQLite. Infinite pages, KaTeX, code blocks, and dual theme."
  lang="en"
>
  <Navbar lang="en" />
  <main>
    <Hero lang="en" />
    <FeaturesGrid lang="en" />
    <Screenshots lang="en" />
    <ArchitectureSection lang="en" />
    <FileStorage lang="en" />
    <DeployMethods lang="en" />
    <SqlMigrationsSection lang="en" />
    <ApiReference lang="en" />
    <ConfigSecrets lang="en" />
    <DownloadCta lang="en" />
  </main>
  <Footer lang="en" />
</Layout>
