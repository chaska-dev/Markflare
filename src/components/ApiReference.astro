---
import Icon from './Icon.astro';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';

const endpoints = [
  { method: 'POST', path: '/api/auth/login', auth: false, descEs: 'Obtener token de acceso Bearer (24h)', descEn: 'Get 24h bearer token', category: 'auth' },
  { method: 'GET', path: '/api/pages', auth: true, descEs: 'Listar todas las páginas del usuario', descEn: 'List all user pages', category: 'pages' },
  { method: 'POST', path: '/api/pages', auth: true, descEs: 'Crear una nueva página', descEn: 'Create a new page', category: 'pages' },
  { method: 'POST', path: '/api/pages/import', auth: true, descEs: 'Crear una página desde archivo Markdown', descEn: 'Create page from markdown file', category: 'pages' },
  { method: 'GET', path: '/api/pages/:id', auth: true, descEs: 'Obtener detalles de página y bloques ordenados', descEn: 'Page metadata and ordered blocks', category: 'pages' },
  { method: 'GET', path: '/api/pages/:id/export', auth: true, descEs: 'Exportar página completa como archivo Markdown', descEn: 'Export page as markdown file', category: 'pages' },
  { method: 'PUT', path: '/api/pages/:id', auth: true, descEs: 'Actualizar título, icono o posición de la página', descEn: 'Update page title, icon, or position', category: 'pages' },
  { method: 'DELETE', path: '/api/pages/:id', auth: true, descEs: 'Eliminar página y sus descendientes en cascada', descEn: 'Cascade delete page + all subpages', category: 'pages' },
  { method: 'POST', path: '/api/pages/:id/blocks', auth: true, descEs: 'Crear un nuevo bloque dentro de una página', descEn: 'Create a new block inside page', category: 'blocks' },
  { method: 'PUT', path: '/api/blocks/:id', auth: true, descEs: 'Actualizar contenido de bloque (re-parenting seguro)', descEn: 'Update block content (cyclic-safe reparenting)', category: 'blocks' },
  { method: 'DELETE', path: '/api/blocks/:id', auth: true, descEs: 'Eliminar bloque permanentemente', descEn: 'Delete a single block', category: 'blocks' },
  { method: 'PUT', path: '/api/blocks/reorder', auth: true, descEs: 'Reordenar múltiples bloques en lote', descEn: 'Batch reorder blocks', category: 'blocks' },
  { method: 'POST', path: '/api/files/upload', auth: true, descEs: 'Subir archivo o imagen (≤ 25 MB, multipart)', descEn: 'Upload file or image (≤ 25 MB, multipart)', category: 'files' },
  { method: 'GET', path: '/api/files/:id', auth: false, descEs: 'Transmitir archivo (público para que los shares rendericen)', descEn: 'Stream a file (public so share pages render)', category: 'files' },
  { method: 'GET', path: '/api/workspace', auth: true, descEs: 'Obtener nombre e icono de la barra lateral', descEn: 'Get sidebar name and workspace icon', category: 'workspace' },
  { method: 'PUT', path: '/api/workspace', auth: true, descEs: 'Actualizar nombre e icono del espacio de trabajo', descEn: 'Update workspace name and icon', category: 'workspace' },
  { method: 'POST', path: '/api/pages/:id/share', auth: true, descEs: 'Activar enlace de compartir público (128-bit)', descEn: 'Activate public 128-bit share link', category: 'shares' },
  { method: 'GET', path: '/api/pages/:id/share', auth: true, descEs: 'Obtener estado del enlace de compartir activo', descEn: 'Get active share status', category: 'shares' },
  { method: 'DELETE', path: '/api/pages/:id/share', auth: true, descEs: 'Revocar enlace público inmediatamente', descEn: 'Revoke public share link', category: 'shares' },
  { method: 'GET', path: '/api/share/:token', auth: false, descEs: 'Árbol de páginas público para un token activo', descEn: 'Public page tree for an active share token', category: 'shares' },
  { method: 'GET', path: '/api/share/:token/page/:pageId', auth: false, descEs: 'Contenido de página pública dentro del árbol compartido', descEn: 'Public page content within the share tree', category: 'shares' },
];
---

<section id="api" class="api-section">
  <div class="container">
    <div class="section-header">
      <span class="badge badge-accent">
        {isEs ? 'REFERENCIA DE LA API' : 'API REFERENCE'}
      </span>
      <h2 class="section-title">
        {isEs ? 'Endpoints RESTful Limpios y Tipados' : 'Clean & Typed RESTful Endpoints'}
      </h2>
      <p class="section-desc">
        {isEs
          ? 'Todas las rutas están montadas bajo /api. Las que muestran un candado requieren el header Bearer token obtenido mediante POST /api/auth/login.'
          : 'All routes are mounted under /api. The ones marked with a padlock require an Authorization: Bearer <token> header issued from POST /api/auth/login.'}
      </p>
    </div>

    <!-- Category Filter Controls -->
    <div class="api-filter-bar">
      <button class="filter-btn active" data-filter="all">
        {isEs ? 'Todos (21)' : 'All (21)'}
      </button>
      <button class="filter-btn" data-filter="auth">Auth</button>
      <button class="filter-btn" data-filter="pages">{isEs ? 'Páginas' : 'Pages'}</button>
      <button class="filter-btn" data-filter="blocks">{isEs ? 'Bloques' : 'Blocks'}</button>
      <button class="filter-btn" data-filter="files">{isEs ? 'Archivos' : 'Files'}</button>
      <button class="filter-btn" data-filter="shares">{isEs ? 'Compartir' : 'Shares'}</button>
      <button class="filter-btn" data-filter="workspace">Workspace</button>
    </div>

    <!-- API Table Card -->
    <div class="api-table-card">
      <div class="table-responsive">
        <table class="api-table">
          <thead>
            <tr>
              <th style="width: 100px;">{isEs ? 'Método' : 'Method'}</th>
              <th style="width: 320px;">Endpoint</th>
              <th style="width: 100px;">{isEs ? 'Seguridad' : 'Auth'}</th>
              <th>{isEs ? 'Propósito' : 'Purpose'}</th>
            </tr>
          </thead>
          <tbody>
            {
              endpoints.map((ep) => (
                <tr class="api-row" data-category={ep.category}>
                  <td>
                    <span class={`method-badge ${ep.method.toLowerCase()}`}>
                      {ep.method}
                    </span>
                  </td>
                  <td>
                    <code class="endpoint-path">{ep.path}</code>
                  </td>
                  <td>
                    {ep.auth ? (
                      <span class="auth-pill locked" title="Requiere Bearer token">
                        <Icon name="lock" size={12} /> <span>Bearer</span>
                      </span>
                    ) : (
                      <span class="auth-pill public" title="Acceso público">
                        <span>Público</span>
                      </span>
                    )}
                  </td>
                  <td class="endpoint-desc">
                    {isEs ? ep.descEs : ep.descEn}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<script>
  function initApiFilter() {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const rows = document.querySelectorAll('.api-row');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        if (!filter) return;

        filterButtons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        rows.forEach((row) => {
          const cat = row.getAttribute('data-category');
          if (filter === 'all' || cat === filter) {
            (row as HTMLElement).style.display = '';
          } else {
            (row as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initApiFilter);
</script>

<style>
  .api-section {
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }

  .api-filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }

  .filter-btn {
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .filter-btn:hover {
    background-color: var(--bg-hover);
    color: var(--text-primary);
  }

  .filter-btn.active {
    background-color: var(--accent);
    color: #ffffff;
    border-color: var(--accent);
  }

  .api-table-card {
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .table-responsive {
    overflow-x: auto;
  }

  .api-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    text-align: left;
  }

  .api-table th {
    padding: 12px 16px;
    background-color: var(--bg-tertiary);
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 12px;
    border-bottom: 1px solid var(--border-color);
    white-space: nowrap;
  }

  .api-table td {
    padding: 10px 16px;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    vertical-align: middle;
  }

  .api-table tbody tr:hover {
    background-color: var(--bg-hover);
  }

  .method-badge {
    display: inline-block;
    padding: 2px 6px;
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    text-align: center;
    width: 60px;
  }

  .method-badge.get {
    background-color: rgba(35, 131, 226, 0.15);
    color: #2383e2;
  }

  .method-badge.post {
    background-color: rgba(243, 128, 32, 0.15);
    color: var(--accent);
  }

  .method-badge.put {
    background-color: rgba(226, 178, 35, 0.15);
    color: #e2b223;
  }

  .method-badge.delete {
    background-color: rgba(235, 87, 87, 0.15);
    color: var(--danger);
  }

  .endpoint-path {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text-primary);
  }

  .auth-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11.5px;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
  }

  .auth-pill.locked {
    background-color: var(--bg-tertiary);
    color: var(--text-secondary);
  }

  .auth-pill.public {
    background-color: rgba(39, 174, 96, 0.12);
    color: var(--success);
  }

  .endpoint-desc {
    color: var(--text-secondary);
    font-size: 13px;
  }
</style>
