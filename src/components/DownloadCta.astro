---
interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';
---

<section id="download" class="cta-section">
  <div class="container">
    <div class="cta-card">
      <div class="cta-badge">
        <span class="cta-dot"></span>
        <span>{isEs ? 'CÓDIGO ABIERTO · LICENCIA MIT' : 'OPEN SOURCE · MIT LICENSE'}</span>
      </div>

      <h2 class="cta-title">
        {isEs ? 'Comienza con Markflare en minutos' : 'Get started with Markflare in minutes'}
      </h2>

      <p class="cta-desc">
        {isEs
          ? 'Descarga el código fuente comprimido en formato ZIP para desplegar de inmediato, o visita el repositorio de GitHub para clonarlo, inspeccionar el código o contribuir.'
          : 'Download the source code archive as a ZIP to deploy immediately, or head over to the GitHub repository to clone, inspect the code, or contribute.'}
      </p>

      <div class="cta-buttons">
        <!-- Direct Download ZIP Button -->
        <a
          href="https://github.com/Chaska-dev/Markflare/archive/refs/heads/main.zip"
          class="btn btn-primary btn-lg download-btn"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <div class="btn-text-group">
            <span class="btn-main-text">{isEs ? 'Descargar Código en ZIP' : 'Download Source ZIP'}</span>
            <span class="btn-sub-text">{isEs ? 'Versión estable v1.0.0 (main.zip)' : 'Stable release v1.0.0 (main.zip)'}</span>
          </div>
        </a>

        <!-- GitHub Repo Redirect Button -->
        <a
          href="https://github.com/Chaska-dev/Markflare"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary btn-lg github-btn"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <div class="btn-text-group">
            <span class="btn-main-text">{isEs ? 'Ver en GitHub' : 'View on GitHub'}</span>
            <span class="btn-sub-text">Chaska-dev/Markflare</span>
          </div>
        </a>
      </div>

      <!-- Quick Run Command Bar -->
      <div class="quick-terminal">
        <span class="term-title">{isEs ? 'Inicio rápido en local:' : 'Quick local startup:'}</span>
        <div class="term-row">
          <span class="term-prompt">$</span>
          <code class="term-command">git clone https://github.com/Chaska-dev/Markflare.git && cd Markflare && pnpm install</code>
          <button
            class="code-copy-btn"
            data-copy-target="git clone https://github.com/Chaska-dev/Markflare.git && cd Markflare && pnpm install"
            title={isEs ? 'Copiar comando' : 'Copy command'}
          >
            <span>{isEs ? 'Copiar' : 'Copy'}</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
  }

  .cta-card {
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 56px 36px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.2);
  }

  @media (max-width: 640px) {
    .cta-card {
      padding: 36px 20px;
    }
  }

  .cta-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    border-radius: var(--radius-sm);
    background-color: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .cta-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent);
  }

  .cta-title {
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 12px;
    max-width: 650px;
  }

  @media (min-width: 768px) {
    .cta-title {
      font-size: 40px;
    }
  }

  .cta-desc {
    font-size: 16px;
    color: var(--text-secondary);
    max-width: 620px;
    margin-bottom: 36px;
    line-height: 1.6;
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 40px;
  }

  .btn-text-group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .btn-main-text {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
  }

  .btn-sub-text {
    font-size: 11px;
    opacity: 0.8;
    font-family: var(--font-mono);
  }

  .download-btn, .github-btn {
    padding: 12px 24px;
    height: 52px;
  }

  .quick-terminal {
    background-color: var(--bg-code);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 12px 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 720px;
    width: 100%;
    text-align: left;
  }

  .term-title {
    font-size: 11px;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
  }

  .term-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .term-prompt {
    color: var(--accent);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  .term-command {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text-primary);
    flex: 1;
    overflow-x: auto;
    white-space: nowrap;
  }
</style>
