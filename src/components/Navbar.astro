---
interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;

const isEs = lang === 'es';

const navItems = isEs
  ? [
      { label: 'Características', href: '#features' },
      { label: 'La interfaz', href: '#screenshots' },
      { label: 'Arquitectura', href: '#architecture' },
      { label: 'Despliegue (5 Métodos)', href: '#deploy' },
      { label: 'Migraciones', href: '#migrations' },
      { label: 'API', href: '#api' },
    ]
  : [
      { label: 'Features', href: '#features' },
      { label: 'The interface', href: '#screenshots' },
      { label: 'Architecture', href: '#architecture' },
      { label: 'Deploy (5 Methods)', href: '#deploy' },
      { label: 'Migrations', href: '#migrations' },
      { label: 'API', href: '#api' },
    ];
---

<header class="navbar">
  <div class="container navbar-container">
    <div class="navbar-brand-group">
      <a href={isEs ? '/' : '/en'} class="brand-link" aria-label="Markflare Home">
        <!-- Isometric 3D Cube Icon -->
        <svg
          class="brand-cube"
          width="26"
          height="28"
          viewBox="160 75 136 148"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path d="M174.249 116.228L228.059 148.013V212.699L174.249 180.356V116.228Z" fill="#42474C" />
          <path d="M228.059 148.013L281.869 116.228V180.356L228.059 212.699V148.013Z" fill="#353B41" />
          <path d="M228.059 85L281.869 116.228L228.059 148.013L174.249 116.228L228.059 85Z" fill="#F38020" />
          <path d="M174.249 116.228V180.356L228.059 212.699L281.869 180.356V116.228" stroke="#F7F9F9" stroke-width="5" stroke-linejoin="round" />
          <path d="M228.059 85L281.869 116.228L228.059 148.013L174.249 116.228L228.059 85Z" stroke="#E8FCF7" stroke-width="4" stroke-linejoin="round" />
        </svg>

        <span class="brand-text">
          mark<span class="brand-accent">flare</span>
        </span>
      </a>

      <span class="version-badge">v1.0.0</span>
    </div>

    <!-- Desktop Navigation -->
    <nav class="nav-links">
      {
        navItems.map((item) => (
          <a href={item.href} class="nav-item">
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Right Actions -->
    <div class="navbar-actions">
      <!-- Language Switcher -->
      <a
        href={isEs ? '/en' : '/'}
        class="lang-switch-btn"
        title={isEs ? 'Switch to English' : 'Cambiar a Español'}
      >
        <span class={isEs ? 'lang-active' : ''}>ES</span>
        <span class="lang-divider">/</span>
        <span class={!isEs ? 'lang-active' : ''}>EN</span>
      </a>

      <!-- Theme Toggle -->
      <button
        type="button"
        class="theme-toggle-btn icon-btn"
        aria-label="Toggle dark/light theme"
        title="Cambiar tema"
      >
        <!-- Sun icon (visible in dark mode) -->
        <svg class="sun-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <!-- Moon icon (visible in light mode) -->
        <svg class="moon-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- GitHub Link -->
      <a
        href="https://github.com/Chaska-dev/Markflare"
        target="_blank"
        rel="noopener noreferrer"
        class="github-link icon-btn"
        aria-label="GitHub Repository"
        title="Ver en GitHub"
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>

      <!-- Primary Download CTA Button -->
      <a
        href="https://github.com/Chaska-dev/Markflare/archive/refs/heads/main.zip"
        class="btn btn-primary btn-sm nav-download-btn"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>{isEs ? 'Descargar ZIP' : 'Download ZIP'}</span>
      </a>
    </div>
  </div>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--bg-primary);
    border-bottom: 1px solid var(--border-color);
    backdrop-filter: blur(8px);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .navbar-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 58px;
  }

  .navbar-brand-group {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .brand-cube {
    display: block;
    transition: transform 0.2s ease;
  }

  .brand-link:hover .brand-cube {
    transform: rotate(-6deg) scale(1.05);
  }

  .brand-text {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .brand-accent {
    color: var(--accent);
  }

  .version-badge {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-tertiary);
    background-color: var(--bg-tertiary);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: 22px;
  }

  @media (min-width: 900px) {
    .nav-links {
      display: flex;
    }
  }

  .nav-item {
    font-size: 13.5px;
    color: var(--text-secondary);
    transition: color 0.15s ease;
    font-weight: 500;
  }

  .nav-item:hover {
    color: var(--text-primary);
  }

  .navbar-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .lang-switch-btn {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--text-secondary);
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    background-color: var(--bg-secondary);
    display: flex;
    align-items: center;
    gap: 3px;
    transition: all 0.15s ease;
  }

  .lang-switch-btn:hover {
    background-color: var(--bg-hover);
    color: var(--text-primary);
  }

  .lang-active {
    color: var(--accent);
  }

  .lang-divider {
    color: var(--text-tertiary);
  }

  .icon-btn {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-color);
    background-color: var(--bg-secondary);
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .icon-btn:hover {
    background-color: var(--bg-hover);
    color: var(--text-primary);
    border-color: var(--text-tertiary);
  }

  /* Theme icon toggling based on data-theme */
  :global([data-theme="dark"]) .moon-icon {
    display: none;
  }
  :global([data-theme="dark"]) .sun-icon {
    display: block;
  }

  :global([data-theme="light"]) .sun-icon {
    display: none;
  }
  :global([data-theme="light"]) .moon-icon {
    display: block;
  }

  @media (max-width: 640px) {
    .nav-download-btn span {
      display: none;
    }
    .nav-download-btn {
      padding: 6px 9px;
    }
  }
</style>
