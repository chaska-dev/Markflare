---
import { REPO, readme, type Copy } from '../i18n';

interface Props {
  t: Copy['nav'];
}

const { t } = Astro.props;
---

<header class="nav on-ink">
  <div class="nav-inner">
    <a class="brand" href={t.home} aria-label="Markflare">
      <img src="/favicon.svg" alt="" width="26" height="26" />
      <span>Markflare</span>
    </a>

    <nav class="nav-links" aria-label={t.contents}>
      <a href="#contents">{t.contents}</a>
      <a href="#instructions">{t.instructions}</a>
      <a href="#specs">{t.specs}</a>
      <a href={readme('deploy')}>{t.readme}</a>
    </nav>

    <div class="nav-end">
      <div class="lang">
        <span class="lang-current" aria-current="page">{t.thisLang}</span>
        <a href={t.otherLang.href} hreflang={t.otherLang.label.toLowerCase()} lang={t.otherLang.label.toLowerCase()} aria-label={t.otherLang.name}>
          {t.otherLang.label}
        </a>
      </div>
      <a class="gh" href={REPO}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.48 2 12.02c0 4.42 2.87 8.17 6.84 9.5.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03A9.56 9.56 0 0 1 12 6.84c.85 0 1.71.12 2.5.34 1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.85-2.34 4.7-4.57 4.94.36.31.68.92.68 1.86v2.75c0 .27.18.58.69.48A10.02 10.02 0 0 0 22 12.02C22 6.48 17.52 2 12 2z" />
        </svg>
        <span>{t.github}</span>
      </a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--ink);
    color: var(--label);
    padding-inline: var(--gutter);
  }

  .nav-inner {
    max-width: 1360px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 32px;
    height: 56px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 26px;
    margin-right: auto;
  }

  .nav-links a,
  .lang a,
  .lang-current {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--paper-soft);
    transition: color 140ms var(--ease-out);
  }

  .nav-links a:hover,
  .lang a:hover {
    color: var(--flare);
  }

  .nav-end {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-left: auto;
  }

  .lang {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .lang-current,
  .lang a {
    padding: 4px 7px;
  }

  .lang-current {
    background: var(--flare);
    color: var(--ink);
  }

  .gh {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 14px;
    border: 2px solid var(--label);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background-color 140ms var(--ease-out),
      color 140ms var(--ease-out),
      border-color 140ms var(--ease-out);
  }

  .gh:hover {
    background: var(--flare);
    border-color: var(--flare);
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .gh span {
      display: none;
    }

    .gh {
      padding: 0 9px;
    }
  }
</style>
