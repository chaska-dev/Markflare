---
import Icon from './Icon.astro';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';
---

<section id="config" class="config-section">
  <div class="container">
    <div class="section-header">
      <span class="badge badge-accent">
        {isEs ? 'CONFIGURACIÓN & SEGURIDAD' : 'CONFIGURATION & SECURITY'}
      </span>
      <h2 class="section-title">
        {isEs ? 'Variables de Entorno y Secretos' : 'Environment Variables & Secrets'}
      </h2>
      <p class="section-desc">
        {isEs
          ? 'Markflare está diseñado bajo el principio de mínima superficie de configuración: solo requieres 3 variables para tener un entorno completamente funcional y seguro.'
          : 'Markflare follows a minimal configuration footprint: you only need 3 essential variables for a production-ready, fully secure setup.'}
      </p>
    </div>

    <!-- Secrets Configuration Table -->
    <div class="config-card">
      <div class="table-responsive">
        <table class="config-table">
          <thead>
            <tr>
              <th style="width: 200px;">Variable</th>
              <th style="width: 110px;">{isEs ? 'Requerido' : 'Required'}</th>
              <th>{isEs ? 'Descripción y Generación' : 'Description & Generation'}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code>AUTH_USERNAME</code></td>
              <td><span class="status-req">{isEs ? 'Sí' : 'Yes'}</span></td>
              <td>
                {isEs
                  ? 'El único nombre de usuario autorizado para acceder al espacio de trabajo.'
                  : 'The single authorized username allowed to sign in to the workspace.'}
              </td>
            </tr>
            <tr>
              <td><code>AUTH_PASSWORD</code></td>
              <td><span class="status-req">{isEs ? 'Sí' : 'Yes'}</span></td>
              <td>
                {isEs
                  ? 'Contraseña de acceso. Usa una contraseña fuerte o frase de paso.'
                  : 'Access password. Use a strong password or high-entropy passphrase.'}
              </td>
            </tr>
            <tr>
              <td><code>AUTH_SECRET</code></td>
              <td><span class="status-req">{isEs ? 'Sí' : 'Yes'}</span></td>
              <td>
                <div class="secret-desc-wrapper">
                  <span>
                    {isEs
                      ? 'Cadena aleatoria larga de 32 bytes para firmar tokens HMAC-SHA256. Rotar este valor invalida instantáneamente todas las sesiones activas.'
                      : '32-byte high-entropy string for signing HMAC-SHA256 bearer tokens. Rotating this value immediately invalidates all active sessions.'}
                  </span>
                  <div class="secret-gen-box">
                    <span class="gen-prompt">$</span>
                    <code class="gen-cmd">openssl rand -hex 32</code>
                    <button class="code-copy-btn" data-copy-target="openssl rand -hex 32">
                      <span>{isEs ? 'Copiar comando' : 'Copy command'}</span>
                    </button>
                  </div>
                </div>
              </td>
            </tr>
            <tr>
              <td><code>NOTION_DB_PATH</code></td>
              <td><span class="status-opt">{isEs ? 'Opcional' : 'Optional'}</span></td>
              <td>
                {isEs
                  ? 'Sobrescribe la ruta local del archivo SQLite (por defecto: ./data/notion.db o ./data/markflare.db).'
                  : 'Overrides local SQLite database file path (default: ./data/notion.db or ./data/markflare.db).'}
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Cloudflare Pages Heads-up Alert Box -->
    <div class="alert-box">
      <Icon name="warning" class="alert-icon" size={20} />
      <div class="alert-content">
        <h4>{isEs ? 'Aviso importante sobre Secretos en Cloudflare Pages:' : 'Important notice about Cloudflare Pages Secrets:'}</h4>
        <p>
          {isEs
            ? 'Cloudflare Pages inyecta las variables de entorno en el Worker durante el SIGUIENTE despliegue. Si acabas de agregarlas en el Dashboard y el login te devuelve un error 503, desencadena un nuevo despliegue (haciendo un commit o pulsando "Retry deployment" en la última compilación).'
            : 'Cloudflare Pages injects secrets into the Worker on the NEXT deployment. If you just added them in the Dashboard and login returns a 503 error, trigger a redeploy (push a commit or click "Retry deployment" on the latest build).'}
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .config-section {
    background-color: var(--bg-primary);
  }

  .config-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: 24px;
  }

  .table-responsive {
    overflow-x: auto;
  }

  .config-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
    text-align: left;
  }

  .config-table th {
    padding: 12px 18px;
    background-color: var(--bg-tertiary);
    color: var(--text-secondary);
    font-size: 12px;
    font-weight: 600;
    border-bottom: 1px solid var(--border-color);
  }

  .config-table td {
    padding: 14px 18px;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    vertical-align: top;
  }

  .config-table code {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--accent);
    background-color: var(--bg-code);
    padding: 2px 6px;
    border-radius: 3px;
    border: 1px solid var(--border-color);
  }

  .status-req {
    display: inline-block;
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 11px;
    font-family: var(--font-mono);
    font-weight: 600;
    background-color: rgba(243, 128, 32, 0.15);
    color: var(--accent);
  }

  .status-opt {
    display: inline-block;
    padding: 2px 6px;
    border-radius: 3px;
    font-size: 11px;
    font-family: var(--font-mono);
    background-color: var(--bg-tertiary);
    color: var(--text-tertiary);
  }

  .secret-desc-wrapper {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .secret-gen-box {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    background-color: var(--bg-code);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    width: fit-content;
  }

  .gen-prompt {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
  }

  .gen-cmd {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-primary);
  }

  .alert-box {
    display: flex;
    gap: 14px;
    padding: 16px 20px;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-left: 3px solid #ffbd2e;
    border-radius: var(--radius-md);
  }

  .alert-icon {
    font-size: 20px;
    flex-shrink: 0;
  }

  .alert-content h4 {
    font-size: 13.5px;
    font-weight: 600;
    margin-bottom: 4px;
    color: var(--text-primary);
  }

  .alert-content p {
    font-size: 12.5px;
    color: var(--text-secondary);
    line-height: 1.5;
  }
</style>
