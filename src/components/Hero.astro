---
import CopyCommand from './CopyCommand.astro';
import Plate from './Plate.astro';
import { CLONE, REPO, ZIP, type Copy, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  t: Copy;
}

const { lang, t } = Astro.props;
const h = t.hero;
---

<section class="hero frame fused" aria-labelledby="hero-title">
  <span class="knot" aria-hidden="true"></span>
  <div class="frame-inner">
    <p class="wordmark" aria-hidden="true">Markflare</p>

    <dl class="contents-strip">
      {h.contents.map((c) => (
        <div class="cell">
          <dt>{c.part}</dt>
          <dd>{c.role}</dd>
        </div>
      ))}
    </dl>

    <div class="body">
      <h1 id="hero-title" class="headline"><span class="visually-hidden">Markflare: </span>{h.headline}</h1>
      <div class="pitch">
        <p class="lead">{h.lead}</p>
        <CopyCommand command={CLONE} t={t.copy} class="hero-cmd" />
        <div class="actions">
          <a class="btn btn-solid" href={ZIP}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
              <path d="M12 3v12M6 10l6 6 6-6M4 20h16"></path>
            </svg>
            {h.zip}
          </a>
          <a class="btn btn-line" href={REPO}>{h.github}</a>
        </div>
      </div>
    </div>

    <Plate
      class="hero-plate"
      src={`/screenshots/${lang}/app-editor.webp`}
      mobileSrc={`/screenshots/${lang}/app-mobile.webp`}
      alt={h.plateAlt}
      caption={h.plate}
      ratio="1200 / 760"
      mobileRatio="390 / 640"
      eager
    />
  </div>
  <div class="tape" aria-hidden="true"></div>
</section>

<style>
  .hero {
    padding-top: clamp(20px, 3vw, 40px);
  }

  /* The wordmark is the label printed on the case: it spans the full width. */
  .wordmark {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(4.6rem, 20.4vw, 18.2rem);
    line-height: 0.78;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    margin-left: -0.03em;
    padding-top: 0.06em;
  }

  .contents-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: clamp(14px, 1.6vw, 22px);
    border-top: var(--rule-heavy) solid var(--ink);
    border-bottom: var(--rule) solid var(--ink);
  }

  .cell {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 12px 16px 13px;
    border-left: var(--rule) solid var(--ink);
  }

  .cell:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .cell dt {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }

  .cell dd {
    font-size: 0.98rem;
    font-weight: 500;
    line-height: 1.25;
    color: var(--ink-soft);
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    padding-top: clamp(28px, 3.4vw, 48px);
    padding-bottom: clamp(32px, 4vw, 56px);
    align-items: start;
  }

  /* The real app sits across the full width of the case, close to its actual
     size, so the interface reads as itself. */
  .frame-inner > :global(.hero-plate) {
    margin-bottom: clamp(48px, 6vw, 88px);
  }

  .headline {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 4.6vw, 4.4rem);
    line-height: 0.98;
    letter-spacing: -0.005em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .lead {
    max-width: 46ch;
    font-size: 1.15rem;
    line-height: 1.5;
    font-weight: 500;
  }

  .pitch :global(.hero-cmd) {
    margin-top: 30px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 14px;
  }

  /* Hazard tape closes the case: hard-stop stripes, no blending. */
  .tape {
    height: 22px;
    background: repeating-linear-gradient(
      -45deg,
      var(--ink) 0 16px,
      var(--flare) 16px 32px
    );
    border-top: var(--rule) solid var(--ink);
  }

  @media (max-width: 1080px) {
    .contents-strip {
      grid-template-columns: repeat(2, 1fr);
    }

    .cell:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }

    .cell:nth-child(n + 3) {
      border-top: var(--rule) solid var(--ink);
    }

    .body {
      grid-template-columns: minmax(0, 1fr);
    }

    .pitch {
      max-width: 640px;
    }

    .body {
      gap: 20px;
    }
  }

  @media (max-width: 560px) {
    .contents-strip {
      grid-template-columns: minmax(0, 1fr);
    }

    .cell {
      border-left: 0;
      padding-left: 0;
    }

    .cell + .cell {
      border-top: var(--rule) solid var(--ink);
    }

    .cell dt {
      min-width: 3.2ch;
    }
  }
</style>
