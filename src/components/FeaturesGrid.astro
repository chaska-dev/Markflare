---
import Icon from './Icon.astro';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';

const features = isEs
  ? [
      {
        tag: 'EDITOR CORE',
        title: 'Bloques dinámicos & Menú Slash',
        description: 'Escribe a la velocidad del pensamiento. Párrafos, encabezados H1-H3, listas de tareas, bloques de citas y desplegables sin fricción.',
        icon: 'edit',
        highlight: 'Slash menu instantáneo con "/"',
      },
      {
        tag: 'JERARQUÍA',
        title: 'Páginas y Subpáginas Infinitas',
        description: 'Organiza tus proyectos en un árbol jerárquico anidado sin restricciones de profundidad. Eliminación en cascada segura en base de datos.',
        icon: 'folder',
        highlight: 'ON DELETE CASCADE en SQLite',
      },
      {
        tag: 'CIENCIA & DEV',
        title: 'Fórmulas KaTeX & Código Resaltado',
        description: 'Renderizado instantáneo de expresiones matemáticas en LaTeX y bloques de código con soporte multilingüe y botón de copia directa.',
        icon: 'sigma',
        highlight: 'KaTeX v0.18 + Syntax Highlighting',
      },
      {
        tag: 'DISTRIBUCIÓN',
        title: 'Enlaces Públicos con Tokens de 128-bit',
        description: 'Comparte cualquier nota o rama de páginas mediante un token criptográfico único. Revocación en un clic y aislamiento del resto del espacio.',
        icon: 'link',
        highlight: 'Tokens no predecibles con revocación',
      },
      {
        tag: 'ALMACENAMIENTO',
        title: 'Archivos y Medios Integrados',
        description: 'Sube imágenes y adjuntos de hasta 25 MB. Los bytes van a un bucket R2 privado y en D1 queda solo la metadata, así la base nunca se llena de blobs.',
        icon: 'image',
        highlight: 'Límite de 25 MB por archivo',
      },
      {
        tag: 'PORTABILIDAD',
        title: 'Importación y Exportación Markdown',
        description: 'Exporta tus páginas en formato Markdown limpio en un clic o crea nuevas páginas importando archivos .md existentes. Tus notas nunca quedan atrapadas.',
        icon: 'download',
        highlight: 'Cero vendor lock-in',
      },
      {
        tag: 'GLOBALIZACIÓN',
        title: 'Bilingüe Nativo (Español / Inglés)',
        description: 'Toda la interfaz está disponible en español e inglés sin cargar frameworks de traducción pesados. Se conmuta instantáneamente.',
        icon: 'globe',
        highlight: 'EN / ES instantáneo',
      },
      {
        tag: 'DISEÑO',
        title: 'Doble Tema & Tinte de Íconos',
        description: 'Modo oscuro afilado (#191919) y modo claro limpio con soporte para personalizar el tinte de íconos de forma independiente en cada tema.',
        icon: 'palette',
        highlight: 'Tokens de diseño precisos',
      },
    ]
  : [
      {
        tag: 'EDITOR CORE',
        title: 'Dynamic Blocks & Slash Menu',
        description: 'Write at the speed of thought. Paragraphs, H1-H3 headings, to-do checkboxes, callouts, and quote blocks without friction.',
        icon: 'edit',
        highlight: 'Instant slash menu with "/"',
      },
      {
        tag: 'HIERARCHY',
        title: 'Infinite Pages & Subpages',
        description: 'Organize your knowledge in an infinitely nested page tree. Built with database-level cascade deletion for clean maintenance.',
        icon: 'folder',
        highlight: 'ON DELETE CASCADE in SQLite',
      },
      {
        tag: 'SCIENCE & CODE',
        title: 'KaTeX Math & Syntax Highlighted Code',
        description: 'Blazing fast LaTeX math typesetting combined with multi-language code snippets featuring one-click copy buttons.',
        icon: 'sigma',
        highlight: 'KaTeX v0.18 + Syntax Highlighting',
      },
      {
        tag: 'SHARING',
        title: 'Public Links with 128-bit Tokens',
        description: 'Share any single note or subpage tree through a secure 128-bit token. Revoke access instantly with scoped visitor permissions.',
        icon: 'link',
        highlight: 'Cryptographic share tokens',
      },
      {
        tag: 'STORAGE',
        title: 'Integrated File & Image Uploads',
        description: 'Upload images and files up to 25 MB. The bytes go to a private R2 bucket and only the metadata stays in D1, so the database never fills up with blobs.',
        icon: 'image',
        highlight: 'Up to 25 MB per file',
      },
      {
        tag: 'PORTABILITY',
        title: 'Markdown Import & Export',
        description: 'Export any page to pure Markdown with one click or create pages by importing .md files. Your notes are always yours.',
        icon: 'download',
        highlight: 'Zero vendor lock-in',
      },
      {
        tag: 'LOCALIZATION',
        title: 'Native Bilingual UI (EN / ES)',
        description: 'The entire interface is crafted in both English and Spanish without heavy external libraries. Switch locales with zero reload.',
        icon: 'globe',
        highlight: 'Native EN / ES support',
      },
      {
        tag: 'AESTHETICS',
        title: 'Dual Theme & Icon Color Tinting',
        description: 'Sharp dark mode (#191919) and crisp light mode with independent icon color personalization for each theme.',
        icon: 'palette',
        highlight: 'Precision design tokens',
      },
    ];
---

<section id="features" class="features-section">
  <div class="container">
    <div class="section-header">
      <span class="badge badge-accent">
        {isEs ? 'CAPACIDADES COMPLETAS' : 'FULL CAPABILITIES'}
      </span>
      <h2 class="section-title">
        {isEs ? 'Todo lo que necesitas para pensar y documentar' : 'Everything you need to write and document'}
      </h2>
      <p class="section-desc">
        {isEs
          ? 'Diseñado para ser rápido, privado y confiable. Sin anuncios, sin telemetría invasiva y con persistencia total en tu propia base de datos SQLite.'
          : 'Built to be fast, private, and dependable. No ads, no tracking, and 100% data persistence in your own SQLite database.'}
      </p>
    </div>

    <!-- Features Grid -->
    <div class="features-grid">
      {
        features.map((feat) => (
          <article class="feature-card">
            <div class="card-top">
              <span class="feature-icon"><Icon name={feat.icon} size={24} /></span>
              <span class="feature-tag">{feat.tag}</span>
            </div>
            <h3 class="feature-title">{feat.title}</h3>
            <p class="feature-desc">{feat.desc || feat.description}</p>
            <div class="card-footer">
              <span class="feature-highlight">{feat.highlight}</span>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features-section {
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1px;
    background-color: var(--border-color);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .feature-card {
    background-color: var(--bg-primary);
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: background-color 0.15s ease;
  }

  .feature-card:hover {
    background-color: var(--bg-secondary);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }

  .feature-icon {
    display: flex;
    color: var(--text-secondary);
  }

  .feature-tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    color: var(--text-tertiary);
    letter-spacing: 0.04em;
  }

  .feature-title {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 8px;
    color: var(--text-primary);
  }

  .feature-desc {
    font-size: 13.5px;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 16px;
    flex: 1;
  }

  .card-footer {
    padding-top: 12px;
    border-top: 1px solid var(--border-subtle);
  }

  .feature-highlight {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--accent);
    font-weight: 500;
  }
</style>
