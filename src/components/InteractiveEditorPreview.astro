---
interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';
const mathEquation = 'f(x) = \\sum_{i=1}^n \\frac{\\partial \\mathcal{L}}{\\partial w_i} x_i + \\lambda \\|w\\|_2^2';
---

<div class="mock-browser-app">
  <!-- Sleek Top Window Chrome -->
  <div class="mock-browser-header">
    <div class="mock-window-buttons">
      <span class="btn-dot close" title="Cerrar"></span>
      <span class="btn-dot min" title="Minimizar"></span>
      <span class="btn-dot max" title="Maximizar"></span>
    </div>

    <div class="mock-address-bar">
      <svg class="lock-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      <span class="url-text">markflare.pages.dev</span>
      <span class="url-path">/page/cloudflare-d1-notes</span>
    </div>

    <div class="mock-status-pill">
      <span class="status-live-dot"></span>
      <span class="status-text">Cloudflare Pages + D1</span>
      <span class="status-latency">12ms edge</span>
    </div>
  </div>

  <!-- Real Markflare App Layout (.layout) -->
  <div class="app-layout">
    <!-- Real Sidebar (.sidebar) -->
    <aside class="app-sidebar">
      <!-- Sidebar Header with exact brandmark -->
      <div class="sidebar-header">
        <div class="workspace-name workspace-name--brand">
          <svg
            class="brand-cube-svg"
            width="20"
            height="22"
            viewBox="160 75 136 148"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d="M174.249 116.228L228.059 148.013V212.699L174.249 180.356V116.228Z" fill="#42474C" />
            <path d="M228.059 148.013L281.869 116.228V180.356L228.059 212.699V148.013Z" fill="#353B41" />
            <path d="M228.059 85L281.869 116.228L228.059 148.013L174.249 116.228L228.059 85Z" fill="#F38020" />
            <path d="M174.249 116.228V180.356L228.059 212.699L281.869 180.356V116.228" stroke="#F7F9F9" stroke-width="5" stroke-linejoin="round" />
            <path d="M228.059 85L281.869 116.228L228.059 148.013L174.249 116.228L228.059 85Z" stroke="#E8FCF7" stroke-width="4" stroke-linejoin="round" />
          </svg>
          <div class="workspace-brand-text">
            <span class="brand-mark">mark</span><span class="brand-accent">flare</span>
          </div>
        </div>

        <div class="sidebar-actions">
          <button class="sidebar-btn" title={isEs ? 'Importar Markdown' : 'Import Markdown'}>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
          </button>
          <button class="sidebar-btn" title={isEs ? 'Nueva página' : 'New page'}>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </button>
          <button class="sidebar-btn" title={isEs ? 'Buscar (Ctrl+K)' : 'Search (Ctrl+K)'}>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </button>
          <button class="sidebar-btn sidebar-btn--toggle" title={isEs ? 'Colapsar barra lateral' : 'Collapse sidebar'}>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
        </div>
      </div>

      <!-- Real Sidebar Search Row -->
      <div class="sidebar-search-row">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span>{isEs ? 'Buscar notas...' : 'Search notes...'}</span>
        <kbd class="sidebar-kbd">Ctrl K</kbd>
      </div>

      <!-- Real Page List with Structured Sections -->
      <div class="page-list">
        <!-- Section 1: RECENTS -->
        <div class="sidebar-section">
          <div class="sidebar-section-header">
            <span class="sidebar-section-title">{isEs ? 'RECIENTES' : 'RECENTS'}</span>
          </div>
          <div class="sidebar-recents-list">
            <div class="sidebar-recent-item active" data-page-title="Cloudflare D1 Notes" data-page-icon="⚡">
              <span class="sidebar-recent-icon">⚡</span>
              <span class="sidebar-recent-title">Cloudflare D1 Notes</span>
            </div>
            <div class="sidebar-recent-item" data-page-title={isEs ? 'Esquema de Migraciones' : 'Migrations Schema'} data-page-icon="📦">
              <span class="sidebar-recent-icon">📦</span>
              <span class="sidebar-recent-title">{isEs ? 'Esquema de Migraciones' : 'Migrations Schema'}</span>
            </div>
          </div>
        </div>

        <!-- Section 2: PROJECTS -->
        <div class="sidebar-section">
          <div class="sidebar-section-header">
            <span class="sidebar-section-title">{isEs ? 'PROYECTOS' : 'PROJECTS'}</span>
            <button class="sidebar-section-add-btn" title={isEs ? 'Añadir proyecto' : 'Add project'}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </button>
          </div>

          <div class="sidebar-tree-group">
            <div class="page-item active-parent" data-page-title="Markflare Workspace" data-page-icon="📋">
              <button class="toggle-btn expanded">▾</button>
              <span class="page-item-icon">📋</span>
              <span class="page-item-title">Markflare Workspace</span>
            </div>
            <!-- Subpages with real indent -->
            <div class="page-children">
              <div class="page-item" data-page-title={isEs ? 'Tablas D1 & SQL' : 'D1 SQL Tables'} data-page-icon="📦">
                <button class="toggle-btn">›</button>
                <span class="page-item-icon">📦</span>
                <span class="page-item-title">{isEs ? 'Tablas D1 & SQL' : 'D1 SQL Tables'}</span>
              </div>
              <div class="page-item" data-page-title={isEs ? 'Tokens de Acceso' : 'Auth & Secrets'} data-page-icon="🔒">
                <button class="toggle-btn">›</button>
                <span class="page-item-icon">🔒</span>
                <span class="page-item-title">{isEs ? 'Tokens de Acceso' : 'Auth & Secrets'}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Section 3: PRIVATE -->
        <div class="sidebar-section">
          <div class="sidebar-section-header">
            <span class="sidebar-section-title">{isEs ? 'PRIVADO' : 'PRIVATE'}</span>
            <button class="sidebar-section-add-btn" title={isEs ? 'Añadir nota privada' : 'Add private note'}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </button>
          </div>

          <div class="sidebar-tree-group">
            <div class="page-item" data-page-title={isEs ? 'Comenzar rápido' : 'Getting Started'} data-page-icon="🚀">
              <button class="toggle-btn">›</button>
              <span class="page-item-icon">🚀</span>
              <span class="page-item-title">{isEs ? 'Comenzar rápido' : 'Getting Started'}</span>
            </div>
            <div class="page-item" data-page-title={isEs ? 'Hoja de Ruta v1.1' : 'Roadmap v1.1'} data-page-icon="📝">
              <button class="toggle-btn">›</button>
              <span class="page-item-icon">📝</span>
              <span class="page-item-title">{isEs ? 'Hoja de Ruta v1.1' : 'Roadmap v1.1'}</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Real Sidebar Footer: User profile & Theme switcher -->
      <div class="sidebar-footer">
        <div class="sidebar-user">
          <div class="user-avatar-circle">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </div>
          <span class="sidebar-user-name">admin</span>
        </div>
        <button class="sidebar-theme-btn" title={isEs ? 'Tema Oscuro Activo' : 'Dark Theme Active'}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </div>
    </aside>

    <!-- Real Main Content Area (.main-content) -->
    <main class="app-main-content">
      <div class="page-view page-view--has-cover">
        <!-- Top Page Navigation Bar (Breadcrumbs & Actions) -->
        <div class="page-main-header">
          <div class="page-breadcrumbs">
            <span class="breadcrumb-link">
              <span class="breadcrumb-icon">📋</span>
              <span>Markflare Workspace</span>
            </span>
            <span class="breadcrumb-separator">/</span>
            <span class="breadcrumb-link active">
              <span class="breadcrumb-icon preview-crumb-icon">⚡</span>
              <span class="preview-crumb-title">Cloudflare D1 Notes</span>
            </span>
          </div>

          <div class="page-actions">
            <button class="page-action-btn page-action-btn--project-active">
              <span>{isEs ? 'Proyecto' : 'Project'}</span>
            </button>
            <button class="page-action-btn" title={isEs ? 'Exportar como Markdown' : 'Export as Markdown'}>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="17 8 12 3 7 8"></polyline>
                <line x1="12" y1="3" x2="12" y2="15"></line>
              </svg>
              <span>{isEs ? 'Exportar' : 'Export'}</span>
            </button>
            <button class="page-action-btn" title={isEs ? 'Nueva subpágina' : 'New subpage'}>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              <span>{isEs ? 'Subpágina' : 'Subpage'}</span>
            </button>
            <button class="page-action-btn" title={isEs ? 'Compartir públicamente con token 128-bit' : 'Public 128-bit share link'}>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="18" cy="5" r="3"></circle>
                <circle cx="6" cy="12" r="3"></circle>
                <circle cx="18" cy="19" r="3"></circle>
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
              </svg>
              <span>{isEs ? 'Compartir' : 'Share'}</span>
            </button>
          </div>
        </div>

        <!-- Real Cover Banner (.page-cover-banner) with Flare Orange gradient -->
        <div class="page-cover-container">
          <div class="page-cover-banner" id="preview-cover-banner">
            <div class="page-cover-actions">
              <span class="page-cover-dim-tag" id="preview-cover-tag">1500 × 600 px</span>
              <button class="page-cover-action-btn" id="preview-change-cover-btn" title={isEs ? 'Haz clic para probar gradientes de Markflare' : 'Click to cycle Markflare gradients'}>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                  <circle cx="12" cy="13" r="4"></circle>
                </svg>
                <span>{isEs ? 'Cambiar portada' : 'Change cover'}</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Overlapping Page Header (.page-header--with-cover) - LEFT ALIGNED -->
        <div class="page-header page-header--with-cover">
          <button class="page-icon-btn page-icon-btn--cover-overlap" title="Emoji de página">
            <span class="preview-page-icon-emoji">⚡</span>
          </button>
          <div class="page-title-wrap">
            <h1 class="page-title preview-page-title-text">Cloudflare D1 Notes</h1>
            <div class="page-meta-row">
              <span class="page-meta-tag">{isEs ? 'Última edición hace 2 min' : 'Edited 2 mins ago'}</span>
              <span class="page-meta-bullet">•</span>
              <span class="page-meta-tag">{isEs ? 'SQLite en el Edge de Cloudflare' : 'SQLite on Cloudflare Edge'}</span>
              <span class="page-meta-bullet">•</span>
              <span class="page-meta-badge">
                <span class="meta-badge-dot"></span>
                <span>{isEs ? 'Público (token 128-bit)' : 'Public (128-bit token)'}</span>
              </span>
            </div>
          </div>
        </div>

        <!-- Real Block Editor (.block-editor) with authentic Notion rhythm -->
        <div class="block-editor">
          <!-- BLOCK 1: Callout Block -->
          <div class="block-wrapper">
            <div class="block-handle" title={isEs ? 'Arrastrar bloque' : 'Drag block'}>⠿</div>
            <div class="block-callout">
              <div class="block-callout-icon">💡</div>
              <div class="block-content">
                <strong>{isEs ? 'Rendimiento Serverless' : 'Serverless Performance'}:</strong> {isEs
                  ? 'Markflare ejecuta cada consulta SQL directamente en la red edge de Cloudflare con latencia ultra-baja y sin servidores que mantener.'
                  : 'Markflare executes each SQL query directly on Cloudflare’s global edge with ultra-low latency and zero servers to maintain.'}
              </div>
            </div>
          </div>

          <!-- BLOCK 2: Heading 2 -->
          <div class="block-wrapper">
            <div class="block-handle" title="Arrastrar">⠿</div>
            <div class="block-content heading2">
              {isEs ? 'Pasos para auto-hospedar' : 'Steps to self-host'}
            </div>
          </div>

          <!-- BLOCK 3: Todo List items with interactive checkboxes -->
          <div class="block-wrapper">
            <div class="block-handle" title="Arrastrar">⠿</div>
            <div class="block-todo preview-todo-item checked">
              <input type="checkbox" checked />
              <div class="block-content">
                {isEs ? 'Clonar repositorio con git clone o descargar archivo ZIP' : 'Clone repository with git clone or download ZIP archive'}
              </div>
            </div>
          </div>

          <div class="block-wrapper">
            <div class="block-handle" title="Arrastrar">⠿</div>
            <div class="block-todo preview-todo-item checked">
              <input type="checkbox" checked />
              <div class="block-content">
                {isEs ? 'Crear base de datos markflare-db en Cloudflare D1' : 'Create markflare-db on Cloudflare D1'}
              </div>
            </div>
          </div>

          <div class="block-wrapper">
            <div class="block-handle" title="Arrastrar">⠿</div>
            <div class="block-todo preview-todo-item">
              <input type="checkbox" />
              <div class="block-content">
                {isEs ? 'Pegar los 4 bloques SQL de migraciones en la D1 Console' : 'Paste 4 SQL migration blocks in D1 Console'}
              </div>
            </div>
          </div>

          <div class="block-wrapper">
            <div class="block-handle" title="Arrastrar">⠿</div>
            <div class="block-todo preview-todo-item">
              <input type="checkbox" />
              <div class="block-content">
                {isEs ? 'Configurar AUTH_USERNAME, AUTH_PASSWORD y AUTH_SECRET' : 'Configure AUTH_USERNAME, AUTH_PASSWORD, and AUTH_SECRET'}
              </div>
            </div>
          </div>

          <!-- BLOCK 4: Code Block with working copy button -->
          <div class="block-wrapper">
            <div class="block-handle" title="Arrastrar">⠿</div>
            <div class="block-code-card">
              <div class="block-code-header">
                <span class="code-lang-tag">bash</span>
                <button type="button" class="block-code-copy-btn" id="preview-code-copy-btn">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <span>{isEs ? 'Copiar' : 'Copy'}</span>
                </button>
              </div>
              <pre class="block-code-pre"><code><span class="code-comment"># Compilar SPA y publicar en Cloudflare Pages</span>
<span class="code-prompt">$</span> pnpm run build
<span class="code-prompt">$</span> wrangler pages deploy dist
<span class="code-success">✨ Compiled SPA &amp; Pages Functions deployed to markflare.pages.dev</span></code></pre>
            </div>
          </div>

          <!-- BLOCK 5: Subpage Link Block (.block-subpage) -->
          <div class="block-wrapper">
            <div class="block-handle" title="Arrastrar">⠿</div>
            <a href="#migrations" class="block-subpage">
              <span class="block-subpage-icon">📦</span>
              <span class="block-subpage-title">{isEs ? 'Esquema de Migraciones D1 SQL' : 'D1 SQL Migrations Schema'}</span>
              <span class="block-subpage-arrow">↗</span>
            </a>
          </div>

          <!-- BLOCK 6: Math KaTeX Block (Crisp LaTeX typography) -->
          <div class="block-wrapper">
            <div class="block-handle" title="Arrastrar">⠿</div>
            <div class="block-math-box">
              <div class="math-rendered-formula">
                <span class="math-symbol">f(x) = ∑</span>
                <span class="math-sub">i=1</span>
                <span class="math-sup">n</span>
                <span class="math-frac">
                  <span class="math-num">∂ℒ</span>
                  <span class="math-den">∂w<sub>i</sub></span>
                </span>
                <span class="math-symbol">x<sub>i</sub> + λ ‖w‖₂²</span>
              </div>
            </div>
          </div>

          <!-- BLOCK 7: Active Line + Slash Menu (Cleanly positioned BELOW the line, zero overlap) -->
          <div class="block-wrapper active-editing-line">
            <div class="block-handle" style="opacity: 1;">⠿</div>
            <div class="block-content slash-prompt-line">
              <span class="slash-char">/</span>
              <span class="slash-placeholder-text">{isEs ? 'Escribe "/" para comandos o empieza a teclear...' : 'Type "/" for commands or start typing...'}</span>
              <span class="caret-blink"></span>
            </div>
          </div>

          <!-- Dedicated Slash Menu Drawer (Positioned cleanly below, NEVER blocks the code) -->
          <div class="slash-menu-drawer">
            <div class="slash-menu-header">
              <span class="slash-menu-title">{isEs ? 'BLOQUES BÁSICOS' : 'BASIC BLOCKS'}</span>
              <span class="slash-menu-hint">{isEs ? 'Navega con flechas' : 'Navigate with arrows'}</span>
            </div>
            <div class="slash-menu-list">
              <div class="slash-menu-item active">
                <div class="slash-menu-item-icon h1-icon">H1</div>
                <div class="slash-menu-item-info">
                  <span class="slash-menu-item-label">{isEs ? 'Encabezado 1' : 'Heading 1'}</span>
                  <span class="slash-menu-item-desc">{isEs ? 'Título de sección grande' : 'Large section heading'}</span>
                </div>
              </div>
              <div class="slash-menu-item">
                <div class="slash-menu-item-icon check-icon">☑</div>
                <div class="slash-menu-item-info">
                  <span class="slash-menu-item-label">{isEs ? 'Lista de Tareas' : 'To-do List'}</span>
                  <span class="slash-menu-item-desc">{isEs ? 'Seguimiento con casillas' : 'Track tasks with checkboxes'}</span>
                </div>
              </div>
              <div class="slash-menu-item">
                <div class="slash-menu-item-icon code-icon">&lt;/&gt;</div>
                <div class="slash-menu-item-info">
                  <span class="slash-menu-item-label">{isEs ? 'Bloque de Código' : 'Code Block'}</span>
                  <span class="slash-menu-item-desc">{isEs ? 'Resaltado con múltiples lenguajes' : 'Syntax-highlighted code'}</span>
                </div>
              </div>
              <div class="slash-menu-item">
                <div class="slash-menu-item-icon math-icon">Σ</div>
                <div class="slash-menu-item-info">
                  <span class="slash-menu-item-label">{isEs ? 'Ecuación KaTeX' : 'Math Equation'}</span>
                  <span class="slash-menu-item-desc">{isEs ? 'Fórmulas matemáticas LaTeX' : 'LaTeX math typesetting'}</span>
                </div>
              </div>
              <div class="slash-menu-item">
                <div class="slash-menu-item-icon callout-icon">💡</div>
                <div class="slash-menu-item-info">
                  <span class="slash-menu-item-label">Callout</span>
                  <span class="slash-menu-item-desc">{isEs ? 'Caja destacada con emoji' : 'Highlighted box with icon'}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</div>

<script>
  // Interactive preview logic
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Cover Gradient Switcher
    const PRESET_GRADIENTS = [
      { name: 'Flare Orange', value: 'linear-gradient(135deg, #F38020 0%, #FAAD3F 50%, #FF5A00 100%)' },
      { name: 'Sunset Coral', value: 'linear-gradient(135deg, #ff7e5f 0%, #feb47b 100%)' },
      { name: 'Aurora', value: 'linear-gradient(135deg, #0575E6 0%, #00F260 100%)' },
      { name: 'Cyberpunk', value: 'linear-gradient(135deg, #8A2387 0%, #E94057 50%, #F27121 100%)' },
      { name: 'Deep Ocean', value: 'linear-gradient(135deg, #2b5876 0%, #4e4376 100%)' },
      { name: 'Obsidian Dark', value: 'linear-gradient(135deg, #232526 0%, #414345 100%)' },
    ];
    let gradIdx = 0;
    const coverBanner = document.getElementById('preview-cover-banner');
    const changeCoverBtn = document.getElementById('preview-change-cover-btn');
    const coverTag = document.getElementById('preview-cover-tag');

    changeCoverBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      gradIdx = (gradIdx + 1) % PRESET_GRADIENTS.length;
      const current = PRESET_GRADIENTS[gradIdx];
      if (coverBanner) {
        coverBanner.style.background = current.value;
      }
      if (coverTag) {
        coverTag.textContent = current.name;
        setTimeout(() => {
          coverTag.textContent = '1500 × 600 px';
        }, 1800);
      }
    });

    // 2. Interactive Todo Checkboxes
    const todoRows = document.querySelectorAll('.preview-todo-item');
    todoRows.forEach((row) => {
      const checkbox = row.querySelector('input[type="checkbox"]');
      row.addEventListener('click', (e) => {
        if (e.target !== checkbox && checkbox) {
          checkbox.checked = !checkbox.checked;
        }
        if (checkbox?.checked) {
          row.classList.add('checked');
        } else {
          row.classList.remove('checked');
        }
      });
    });

    // 3. Interactive Code Copy
    const copyBtn = document.getElementById('preview-code-copy-btn');
    const bashSnippet = `# Compilar SPA y publicar en Cloudflare Pages
pnpm run build
wrangler pages deploy dist`;

    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(bashSnippet);
        const originalHtml = copyBtn.innerHTML;
        copyBtn.innerHTML = `
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="color: #27ae60;"><polyline points="20 6 9 17 4 12"></polyline></svg>
          <span style="color: #27ae60;">¡Copiado!</span>
        `;
        setTimeout(() => {
          copyBtn.innerHTML = originalHtml;
        }, 2000);
      } catch (err) {
        console.error('Clipboard copy failed', err);
      }
    });

    // 4. Interactive Sidebar Items
    const sidebarItems = document.querySelectorAll('.app-sidebar .sidebar-recent-item, .app-sidebar .page-item');
    const pageTitleText = document.querySelector('.preview-page-title-text');
    const pageIconEmoji = document.querySelector('.preview-page-icon-emoji');
    const crumbTitle = document.querySelector('.preview-crumb-title');
    const crumbIcon = document.querySelector('.preview-crumb-icon');

    sidebarItems.forEach((item) => {
      item.addEventListener('click', () => {
        sidebarItems.forEach((i) => i.classList.remove('active'));
        item.classList.add('active');

        const title = item.getAttribute('data-page-title');
        const icon = item.getAttribute('data-page-icon');

        if (title && pageTitleText) {
          pageTitleText.textContent = title;
          if (crumbTitle) crumbTitle.textContent = title;
        }
        if (icon && pageIconEmoji) {
          pageIconEmoji.textContent = icon;
          if (crumbIcon) crumbIcon.textContent = icon;
        }
      });
    });

    // 5. Slash Menu Item Clicks
    const slashItems = document.querySelectorAll('.slash-menu-item');
    slashItems.forEach((si) => {
      si.addEventListener('click', () => {
        slashItems.forEach((s) => s.classList.remove('active'));
        si.classList.add('active');
      });
    });
  });
</script>

