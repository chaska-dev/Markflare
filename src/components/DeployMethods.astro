---
interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';
---

<section id="deploy" class="deploy-section">
  <div class="container">
    <div class="section-header">
      <span class="badge badge-accent">
        {isEs ? '5 FORMAS DE DESPLIEGUE' : '5 DEPLOYMENT METHODS'}
      </span>
      <h2 class="section-title">
        {isEs ? 'Despliega a tu manera, sin fricción' : 'Deploy your way, zero friction'}
      </h2>
      <p class="section-desc">
        {isEs
          ? 'Markflare se adapta a cualquier flujo de trabajo. Desde una consola local rápida hasta integración continua automática conectada a GitHub o arrastrar archivos sin tocar la terminal.'
          : 'Markflare adapts to any workflow. From rapid offline local development to automated GitHub CI/CD, or drag-and-drop builds without touching a terminal.'}
      </p>
    </div>

    <!-- Comparative Table from README -->
    <div class="deploy-matrix-card">
      <div class="matrix-header">
        <span class="matrix-title">{isEs ? 'Matriz Comparativa de Métodos' : 'Method Comparison Matrix'}</span>
      </div>
      <div class="table-responsive">
        <table class="matrix-table">
          <thead>
            <tr>
              <th>{isEs ? 'Método' : 'Method'}</th>
              <th>Build</th>
              <th>{isEs ? 'Migraciones' : 'Migrations'}</th>
              <th>{isEs ? 'Enlace D1' : 'D1 Binding'}</th>
              <th>{isEs ? 'Secretos AUTH' : 'AUTH Secrets'}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>1. {isEs ? 'Desarrollo Local' : 'Local Dev'}</strong></td>
              <td><code>pnpm run dev</code></td>
              <td><code>pnpm run db:migrate:all</code></td>
              <td>SQLite local</td>
              <td><code>.dev.vars</code></td>
            </tr>
            <tr>
              <td><strong>2. Dashboard (Clone)</strong></td>
              <td><code>pnpm run build</code></td>
              <td>D1 Console (Copy/Paste)</td>
              <td>Cloudflare UI</td>
              <td>Cloudflare UI</td>
            </tr>
            <tr>
              <td><strong>3. Dashboard (ZIP)</strong></td>
              <td><code>pnpm run build</code></td>
              <td>D1 Console (Copy/Paste)</td>
              <td>Cloudflare UI</td>
              <td>Cloudflare UI</td>
            </tr>
            <tr>
              <td><strong>4. Terminal (wrangler)</strong></td>
              <td><code>pnpm run deploy</code></td>
              <td><code>pnpm run db:migrate:prod</code></td>
              <td><code>wrangler.toml</code> local</td>
              <td>Cloudflare UI</td>
            </tr>
            <tr>
              <td><strong>5. Dashboard (Git-CI)</strong></td>
              <td>Automático en Pages</td>
              <td>D1 Console (Copy/Paste)</td>
              <td>Cloudflare UI</td>
              <td>Cloudflare UI</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Interactive Method Tabs Switcher -->
    <div class="method-interactive-tabs">
      <div class="method-tabs-nav" role="tablist">
        <button class="method-tab-btn active" data-tab="method-1">
          <span class="tab-number">1</span>
          <span>{isEs ? 'Local' : 'Local'}</span>
        </button>
        <button class="method-tab-btn" data-tab="method-2">
          <span class="tab-number">2</span>
          <span>Clone & Build</span>
        </button>
        <button class="method-tab-btn" data-tab="method-3">
          <span class="tab-number">3</span>
          <span>{isEs ? 'Descarga ZIP' : 'Download ZIP'}</span>
        </button>
        <button class="method-tab-btn" data-tab="method-4">
          <span class="tab-number">4</span>
          <span>Wrangler CLI</span>
        </button>
        <button class="method-tab-btn" data-tab="method-5">
          <span class="tab-number">5</span>
          <span>Git Conectado</span>
        </button>
      </div>

      <!-- Tab Panels -->
      <div class="method-panels">
        <!-- METHOD 1 PANEL -->
        <div id="method-1" class="method-panel active">
          <div class="panel-header">
            <h3>{isEs ? 'Método 1: Desarrollo Local (Express + SQLite)' : 'Method 1: Local Development (Express + SQLite)'}</h3>
            <p>
              {isEs
                ? 'Ideal para probar la aplicación, programar o usar Markflare de forma 100% privada y offline en tu propia máquina.'
                : 'Perfect for trying the app, developing, or using Markflare 100% privately and offline on your machine.'}
            </p>
          </div>

          <ol class="steps-list">
            <li class="step-item">
              <span class="step-title">{isEs ? 'Clonar el repositorio e instalar dependencias:' : 'Clone repository and install dependencies:'}</span>
              <div class="code-container">
                <div class="code-header">
                  <span>bash</span>
                  <button class="code-copy-btn" data-copy-target="git clone https://github.com/Chaska-dev/Markflare.git&#10;cd Markflare&#10;pnpm install">
                    <span>{isEs ? 'Copiar comandos' : 'Copy commands'}</span>
                  </button>
                </div>
                <pre class="code-body"><code>git clone https://github.com/Chaska-dev/Markflare.git
cd Markflare
pnpm install</code></pre>
              </div>
            </li>

            <li class="step-item">
              <span class="step-title">{isEs ? 'Configurar variables de entorno locales:' : 'Configure local environment variables:'}</span>
              <div class="code-container">
                <div class="code-header">
                  <span>bash</span>
                  <button class="code-copy-btn" data-copy-target="cp .env.example .dev.vars">
                    <span>{isEs ? 'Copiar' : 'Copy'}</span>
                  </button>
                </div>
                <pre class="code-body"><code>cp .env.example .dev.vars
# Edita .dev.vars con tu AUTH_USERNAME, AUTH_PASSWORD y AUTH_SECRET</code></pre>
              </div>
            </li>

            <li class="step-item">
              <span class="step-title">{isEs ? 'Crear y migrar la base de datos local SQLite:' : 'Create and migrate the local SQLite database:'}</span>
              <div class="code-container">
                <div class="code-header">
                  <span>bash</span>
                  <button class="code-copy-btn" data-copy-target="pnpm run db:migrate:all">
                    <span>{isEs ? 'Copiar' : 'Copy'}</span>
                  </button>
                </div>
                <pre class="code-body"><code>pnpm run db:migrate:all    # Crea data/markflare.db con el esquema inicial</code></pre>
              </div>
            </li>

            <li class="step-item">
              <span class="step-title">{isEs ? 'Iniciar el servidor Express y el cliente Vite:' : 'Start the Express server and Vite frontend:'}</span>
              <div class="code-container">
                <div class="code-header">
                  <span>bash</span>
                  <button class="code-copy-btn" data-copy-target="pnpm run dev">
                    <span>{isEs ? 'Copiar' : 'Copy'}</span>
                  </button>
                </div>
                <pre class="code-body"><code>pnpm run dev               # Express en :3000 + Vite en :5173</code></pre>
              </div>
              <p class="step-note">
                {isEs ? 'Abre http://localhost:5173 e inicia sesión con las credenciales que pusiste en .dev.vars.' : 'Open http://localhost:5173 and sign in with the credentials set in .dev.vars.'}
              </p>
            </li>
          </ol>
        </div>

        <!-- METHOD 2 PANEL -->
        <div id="method-2" class="method-panel">
          <div class="panel-header">
            <h3>{isEs ? 'Método 2: Dashboard — Clonar y Subir dist/' : 'Method 2: Dashboard — Clone & Upload dist/'}</h3>
            <p>
              {isEs
                ? 'El camino más limpio para desarrolladores: compilas localmente y subes la carpeta dist/ a Cloudflare Pages sin configurar wrangler.'
                : 'The cleanest developer path: build locally and upload the dist/ folder to Cloudflare Pages with no wrangler CLI required.'}
            </p>
          </div>

          <ol class="steps-list">
            <li class="step-item">
              <span class="step-title">{isEs ? 'Compilar localmente:' : 'Build locally:'}</span>
              <div class="code-container">
                <pre class="code-body"><code>pnpm install && pnpm run build   # Produce la carpeta dist/</code></pre>
              </div>
            </li>
            <li class="step-item">
              <span class="step-title">{isEs ? 'Crear la base de datos D1 en Cloudflare:' : 'Create D1 database in Cloudflare:'}</span>
              <p class="step-note">
                Workers & Pages → D1 SQL databases → <strong>Create database</strong> → Nombre: <code>markflare-db</code>
              </p>
            </li>
            <li class="step-item">
              <span class="step-title">{isEs ? 'Crear el bucket de archivos en R2:' : 'Create the R2 file bucket:'}</span>
              <p class="step-note">
                {isEs
                  ? 'R2 → Overview → <strong>Create bucket</strong> → Nombre: markflare-files. Déjalo privado, no actives el dominio r2.dev.'
                  : 'R2 → Overview → <strong>Create bucket</strong> → Name: markflare-files. Keep it private, do not enable the r2.dev domain.'}
              </p>
            </li>
            <li class="step-item">
              <span class="step-title">{isEs ? 'Ejecutar las migraciones SQL en la consola de D1:' : 'Apply SQL migrations in D1 Console:'}</span>
              <p class="step-note">
                {isEs
                  ? 'Ve a la pestaña Console de markflare-db y ejecuta los 5 bloques SQL que encontrarás en la sección de Migraciones más abajo.'
                  : 'Go to markflare-db Console tab and run each of the 5 SQL blocks from the Migrations section below.'}
              </p>
            </li>
            <li class="step-item">
              <span class="step-title">{isEs ? 'Crear la aplicación Pages arrastrando dist/:' : 'Create Pages application by uploading dist/:'}</span>
              <p class="step-note">
                Workers & Pages → Create application → Pages → <strong>Upload assets</strong> → Arrastra la carpeta <code>dist/</code>.
              </p>
            </li>
            <li class="step-item">
              <span class="step-title">{isEs ? 'Configurar los bindings y los secretos en Settings:' : 'Configure the bindings and secrets in Settings:'}</span>
              <p class="step-note">
                En <strong>Settings → Functions</strong>: añade el binding de base de datos con Variable name <code>DB</code> vinculado a <code>markflare-db</code>, y el binding de R2 con Variable name <code>BUCKET</code> vinculado a <code>markflare-files</code>.<br/>
                En <strong>Settings → Variables and secrets</strong>: añade <code>AUTH_USERNAME</code>, <code>AUTH_PASSWORD</code> y <code>AUTH_SECRET</code> como tipo <em>Encrypt</em>.
              </p>
            </li>
          </ol>
        </div>

        <!-- METHOD 3 PANEL -->
        <div id="method-3" class="method-panel">
          <div class="panel-header">
            <h3>{isEs ? 'Método 3: Dashboard — Descargar ZIP (Sin Git)' : 'Method 3: Dashboard — Download as ZIP (No Git)'}</h3>
            <p>
              {isEs
                ? 'Ideal si no tienes Git instalado o quieres desplegar rápidamente una copia estática.'
                : 'Ideal if you do not have Git installed or want to deploy quickly from a standalone snapshot.'}
            </p>
          </div>

          <ol class="steps-list">
            <li class="step-item">
              <span class="step-title">{isEs ? 'Descargar y descomprimir el código fuente:' : 'Download and extract the source code:'}</span>
              <div class="cta-inline">
                <a
                  href="https://github.com/Chaska-dev/Markflare/archive/refs/heads/main.zip"
                  class="btn btn-primary btn-sm"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                  </svg>
                  <span>{isEs ? 'Descargar Markflare (.zip)' : 'Download Markflare (.zip)'}</span>
                </a>
              </div>
            </li>
            <li class="step-item">
              <span class="step-title">{isEs ? 'Compilar e instalar:' : 'Install and build:'}</span>
              <div class="code-container">
                <pre class="code-body"><code>pnpm install
pnpm run build</code></pre>
              </div>
            </li>
            <li class="step-item">
              <span class="step-title">{isEs ? 'Subir dist/ a Cloudflare Pages y configurar D1:' : 'Upload dist/ to Cloudflare Pages and attach D1:'}</span>
              <p class="step-note">
                {isEs
                  ? 'Sigue los mismos pasos del Método 2: arrastra dist/ a Pages, crea markflare-db en D1, ejecuta los 4 bloques SQL y define las 3 variables AUTH_*.'
                  : 'Follow the same steps as Method 2: drag dist/ onto Pages, create markflare-db, execute the 4 SQL blocks and set AUTH_* secrets.'}
              </p>
            </li>
          </ol>
        </div>

        <!-- METHOD 4 PANEL -->
        <div id="method-4" class="method-panel">
          <div class="panel-header">
            <h3>{isEs ? 'Método 4: Terminal — Scripting con wrangler CLI' : 'Method 4: Terminal — Scripting with wrangler CLI'}</h3>
            <p>
              {isEs
                ? 'Automatiza todo desde tu consola con comandos wrangler directos. (Requiere crear un wrangler.toml local con tu UUID de D1).'
                : 'Automate everything from the terminal using wrangler commands. (Requires creating a local wrangler.toml with your D1 UUID).'}
            </p>
          </div>

          <ol class="steps-list">
            <li class="step-item">
              <span class="step-title">{isEs ? 'Crear la base de datos D1 y copiar su ID (UUID):' : 'Create D1 database and copy its UUID:'}</span>
              <p class="step-note">
                Workers & Pages → D1 SQL databases → Create database → <code>markflare-db</code> → Copia el <strong>Database ID</strong>.
              </p>
            </li>
            <li class="step-item">
              <span class="step-title">{isEs ? 'Crear el bucket de archivos en R2:' : 'Create the R2 file bucket:'}</span>
              <p class="step-note">
                {isEs
                  ? 'R2 → Overview → Create bucket → <code>markflare-files</code>. El nombre del bucket aparece en el <code>[[r2_buckets]]</code> de la plantilla siguiente.'
                  : 'R2 → Overview → Create bucket → <code>markflare-files</code>. The bucket name goes in the <code>[[r2_buckets]]</code> block of the template below.'}
              </p>
            </li>
            <li class="step-item">
              <span class="step-title">{isEs ? 'Crear wrangler.toml en la raíz del proyecto:' : 'Create wrangler.toml in project root:'}</span>
              <div class="code-container">
                <div class="code-header">
                  <span>wrangler.toml</span>
                  <button class="code-copy-btn" data-copy-target="name = &quot;markflare&quot;&#10;compatibility_date = &quot;2024-09-01&quot;&#10;pages_build_output_dir = &quot;dist&quot;&#10;&#10;[[d1_databases]]&#10;binding = &quot;DB&quot;&#10;database_name = &quot;markflare-db&quot;&#10;database_id = &quot;TU-D1-UUID-AQUI&quot;&#10;&#10;[[r2_buckets]]&#10;binding = &quot;BUCKET&quot;&#10;bucket_name = &quot;markflare-files&quot;">
                    <span>{isEs ? 'Copiar plantilla' : 'Copy template'}</span>
                  </button>
                </div>
                <pre class="code-body"><code>name = "markflare"
compatibility_date = "2024-09-01"
pages_build_output_dir = "dist"

[[d1_databases]]
binding = "DB"
database_name = "markflare-db"
database_id = "PEGA-AQUI-TU-D1-UUID"

[[r2_buckets]]
binding = "BUCKET"
bucket_name = "markflare-files"</code></pre>
              </div>
            </li>
            <li class="step-item">
              <span class="step-title">{isEs ? 'Aplicar migraciones remotas en un solo comando:' : 'Apply remote migrations in one command:'}</span>
              <div class="code-container">
                <pre class="code-body"><code>pnpm run db:migrate:prod   # Ejecuta wrangler d1 migrations apply markflare-db --remote</code></pre>
              </div>
            </li>
            <li class="step-item">
              <span class="step-title">{isEs ? 'Compilar y desplegar a Cloudflare Pages:' : 'Build and deploy to Cloudflare Pages:'}</span>
              <div class="code-container">
                <pre class="code-body"><code>pnpm run deploy            # Compila con Vite y publica en Pages automáticamente</code></pre>
              </div>
            </li>
          </ol>
        </div>

        <!-- METHOD 5 PANEL -->
        <div id="method-5" class="method-panel">
          <div class="panel-header">
            <h3>{isEs ? 'Método 5: Dashboard — Conectado a Git (CI/CD Automático)' : 'Method 5: Dashboard — Git-Connected (Auto CI/CD)'}</h3>
            <p>
              {isEs
                ? 'Conecta tu repositorio de GitHub y Cloudflare Pages compilará y desplegará automáticamente en cada git push.'
                : 'Connect your GitHub repository and Cloudflare Pages will build and deploy automatically on every push.'}
            </p>
          </div>

          <ol class="steps-list">
            <li class="step-item">
              <span class="step-title">{isEs ? 'Subir el repositorio a tu cuenta de GitHub:' : 'Push repository to your GitHub account:'}</span>
              <div class="code-container">
                <pre class="code-body"><code>git push -u origin main</code></pre>
              </div>
            </li>
            <li class="step-item">
              <span class="step-title">{isEs ? 'Conectar Pages a Git:' : 'Connect Pages to Git:'}</span>
              <p class="step-note">
                Workers & Pages → Create application → Pages → <strong>Connect to Git</strong> → Selecciona tu repo <code>markflare</code>.
              </p>
            </li>
            <li class="step-item">
              <span class="step-title">{isEs ? 'Configuración de Build CRÍTICA:' : 'CRITICAL Build Configuration:'}</span>
              <div class="code-container">
                <pre class="code-body"><code>Build command: pnpm run build
Build output directory: dist
Root directory: (dejar en blanco)</code></pre>
              </div>
              <p class="step-note alert">
                {isEs
                  ? 'Importante: Debes escribir explícitamente "pnpm run build". Si lo dejas en blanco, Cloudflare no compilará y las Functions fallarán.'
                  : 'Important: You must explicitly set "pnpm run build". Leaving it blank makes Pages skip compilation, which will break Functions.'}
              </p>
            </li>
            <li class="step-item">
              <span class="step-title">{isEs ? 'Vincular D1 y Secretos:' : 'Attach D1 and Secrets:'}</span>
              <p class="step-note">
                {isEs
                  ? 'En Settings → Functions: vincula DB a markflare-db y BUCKET a markflare-files. En Settings → Variables and secrets: añade AUTH_USERNAME, AUTH_PASSWORD y AUTH_SECRET.'
                  : 'In Settings → Functions: bind DB to markflare-db and BUCKET to markflare-files. In Settings → Variables: add AUTH_USERNAME, AUTH_PASSWORD, AUTH_SECRET.'}
              </p>
            </li>
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Tab switching logic for deployment methods
  function initDeployTabs() {
    const tabButtons = document.querySelectorAll('.method-tab-btn');
    const panels = document.querySelectorAll('.method-panel');

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-tab');
        if (!targetId) return;

        tabButtons.forEach((b) => b.classList.remove('active'));
        panels.forEach((p) => p.classList.remove('active'));

        btn.classList.add('active');
        const targetPanel = document.getElementById(targetId);
        if (targetPanel) {
          targetPanel.classList.add('active');
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initDeployTabs);
</script>

<style>
  .deploy-section {
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
  }

  .deploy-matrix-card {
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    margin-bottom: 36px;
    overflow: hidden;
  }

  .matrix-header {
    padding: 12px 18px;
    background-color: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
  }

  .matrix-title {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
  }

  .table-responsive {
    overflow-x: auto;
  }

  .matrix-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    text-align: left;
  }

  .matrix-table th {
    padding: 10px 16px;
    background-color: var(--bg-tertiary);
    color: var(--text-secondary);
    font-weight: 600;
    font-size: 12px;
    border-bottom: 1px solid var(--border-color);
    white-space: nowrap;
  }

  .matrix-table td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .matrix-table tbody tr:hover {
    background-color: var(--bg-hover);
  }

  .matrix-table code {
    font-family: var(--font-mono);
    font-size: 11.5px;
    padding: 2px 6px;
    background-color: var(--bg-code);
    border: 1px solid var(--border-color);
    border-radius: 3px;
    color: var(--accent);
  }

  /* Interactive Tabs */
  .method-interactive-tabs {
    background-color: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .method-tabs-nav {
    display: flex;
    overflow-x: auto;
    background-color: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
  }

  .method-tab-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text-secondary);
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }

  .method-tab-btn:hover {
    color: var(--text-primary);
    background-color: var(--bg-hover);
  }

  .method-tab-btn.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
    background-color: var(--bg-primary);
    font-weight: 600;
  }

  .tab-number {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: var(--bg-tertiary);
    font-size: 11px;
    font-family: var(--font-mono);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .method-tab-btn.active .tab-number {
    background-color: var(--accent);
    color: #ffffff;
  }

  .method-panels {
    padding: 28px;
  }

  @media (max-width: 640px) {
    .method-panels {
      padding: 18px;
    }
  }

  .method-panel {
    display: none;
  }

  .method-panel.active {
    display: block;
    animation: fadeIn 0.2s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .panel-header {
    margin-bottom: 24px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border-color);
  }

  .panel-header h3 {
    font-size: 18px;
    margin-bottom: 6px;
  }

  .panel-header p {
    font-size: 14px;
    color: var(--text-secondary);
  }

  .steps-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 20px;
    counter-reset: step-counter;
  }

  .step-item {
    position: relative;
    padding-left: 36px;
  }

  .step-item::before {
    counter-increment: step-counter;
    content: counter(step-counter);
    position: absolute;
    left: 0;
    top: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
