---
// The landing had nothing on R2, which is a third of the infrastructure and the
// reason the 25 MB cap exists. This section just says what each service is and
// how to point the app at both.
import Icon from './Icon.astro';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';

const SERVICES = isEs
  ? [
      {
        icon: 'zap',
        name: 'D1',
        role: 'Base de datos',
        body:
          'Un SQLite que corre en el edge de Cloudflare. Es una tabla: lo que guardás son filas de texto — tus páginas, tus bloques, los enlaces de compartir. Lee y escribe en milisegundos porque está cerca de quien lee.',
        facts: [
          ['Guarda', 'Páginas, bloques, enlaces'],
          ['No guarda', 'Imágenes ni adjuntos'],
        ],
      },
      {
        icon: 'image',
        name: 'R2',
        role: 'Almacenamiento de archivos',
        body:
          'Un almacén de objetos, parecido a un drive privado. Ahí van los bytes de tus imágenes y adjuntos, sin base64 ni mouthful dentro de la base. La tabla guarda solo el nombre, el tipo y el tamaño.',
        facts: [
          ['Guarda', 'Imágenes y adjuntos'],
          ['Techo por archivo', '25 MB'],
        ],
      },
    ]
  : [
      {
        icon: 'zap',
        name: 'D1',
        role: 'Database',
        body:
          'A SQLite database running on Cloudflare\'s edge. It is a table: what you store are rows of text — your pages, your blocks, your share links. Reads and writes land in milliseconds because it sits next to whoever is reading.',
        facts: [
          ['Stores', 'Pages, blocks, share links'],
          ['Does not store', 'Images or attachments'],
        ],
      },
      {
        icon: 'image',
        name: 'R2',
        role: 'File storage',
        body:
          'An object store, like a private drive. Your image and attachment bytes go there, with no base64 blob bloating the database. The table keeps only the name, the type and the size.',
        facts: [
          ['Stores', 'Images and attachments'],
          ['Ceiling per file', '25 MB'],
        ],
      },
    ];

const NOTES = isEs
  ? [
      {
        icon: 'shield',
        title: 'El bucket se queda privado',
        body:
          'No actives el dominio público r2.dev. Los archivos se sirven desde /api/files/:id a través del Worker; un bucket público los expondría directo.',
      },
      {
        icon: 'lock',
        title: 'Sin el binding no hay subidas',
        body:
          'Sin BUCKET la API responde 503. A propósito no hay respaldo que escriba en D1: preferimos un fallo visible a una base que se llena sola.',
      },
      {
        icon: 'download',
        title: 'Gratis a esta escala',
        body:
          'El free tier da 10 GB de almacenamiento, 1M escrituras y 10M lecturas al mes, sin cargo por ancho de banda. Pasado ese punto, $0,015/GB-mes.',
      },
    ]
  : [
      {
        icon: 'shield',
        title: 'Keep the bucket private',
        body:
          'Do not turn on the public r2.dev domain. Files are served from /api/files/:id through the Worker; a public bucket would expose them directly.',
      },
      {
        icon: 'lock',
        title: 'No binding, no uploads',
        body:
          'Without BUCKET the API returns 503. On purpose there is no fallback that writes into D1: a loud failure beats a database that quietly fills up.',
      },
      {
        icon: 'download',
        title: 'Free at this scale',
        body:
          'The free tier covers 10 GB of storage, 1M writes and 10M reads a month, with no bandwidth charge. Past that, $0.015/GB-month.',
      },
    ];

const STEPS = isEs
  ? [
      {
        n: '1',
        title: 'Crear el bucket',
        body: 'R2 → Overview → Create bucket. Nombre: markflare-files. Déjalo privado.',
      },
      {
        n: '2',
        title: 'Vincular los dos servicios en Pages',
        body:
          'Workers & Pages → tu proyecto → Settings → Functions → Add. Uno de base de datos con variable DB → markflare-db, y uno de R2 con variable BUCKET → markflare-files.',
      },
    ]
  : [
      {
        n: '1',
        title: 'Create the bucket',
        body: 'R2 → Overview → Create bucket. Name: markflare-files. Keep it private.',
      },
      {
        n: '2',
        title: 'Bind both services in Pages',
        body:
          'Workers & Pages → your project → Settings → Functions → Add. One database binding with variable DB → markflare-db, and one R2 binding with variable BUCKET → markflare-files.',
      },
    ];
---

<section id="storage" class="storage-section">
  <div class="container">
    <div class="section-header">
      <span class="badge badge-accent">
        {isEs ? 'ALMACENAMIENTO' : 'STORAGE'}
      </span>
      <h2 class="section-title">
        {isEs ? 'Dos servicios, dos trabajos' : 'Two services, two jobs'}
      </h2>
      <p class="section-desc">
        {isEs
          ? 'Tus notas van a D1 y tus archivos a R2. Ninguno de los dos puede hacer el trabajo del otro, y por eso la app usa los dos.'
          : 'Your notes go to D1 and your files to R2. Neither service can do the other\'s job, which is why the app uses both.'}
      </p>
    </div>

    <div class="service-grid">
      {
        SERVICES.map((s) => (
          <article class="service-card">
            <div class="service-head">
              <Icon name={s.icon} class="service-icon" size={20} />
              <div>
                <span class="service-name">{s.name}</span>
                <span class="service-role">{s.role}</span>
              </div>
            </div>
            <p class="service-body">{s.body}</p>
            <dl class="service-facts">
              {s.facts.map(([k, v]) => (
                <div class="fact">
                  <dt>{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))
      }
    </div>

    <div class="steps-grid">
      {
        STEPS.map((s) => (
          <div class="setup-step">
            <span class="step-num">{s.n}</span>
            <h3 class="step-title">{s.title}</h3>
            <p class="step-detail">{s.body}</p>
          </div>
        ))
      }
    </div>

    <div class="storage-notes">
      {
        NOTES.map((n) => (
          <div class="note-item">
            <Icon name={n.icon} size={18} class="note-icon" />
            <div>
              <strong>{n.title}</strong>
              <p>{n.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .storage-section {
    background-color: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
  }

  .service-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background-color: var(--border-color);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    overflow: hidden;
  }

  .service-card {
    padding: 26px 24px 24px;
    background-color: var(--bg-primary);
  }

  .service-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }

  .service-icon {
    flex-shrink: 0;
    color: var(--text-secondary);
  }

  .service-name {
    display: block;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--text-primary);
  }

  .service-role {
    display: block;
    font-size: 12.5px;
    color: var(--text-tertiary);
    margin-top: 1px;
  }

  .service-body {
    font-size: 13.5px;
    line-height: 1.65;
  }

  .service-facts {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--border-subtle);
  }

  .fact {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 12.5px;
    line-height: 1.9;
  }

  .fact dt {
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 11.5px;
  }

  .fact dd {
    color: var(--text-secondary);
    text-align: right;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-top: 40px;
  }

  .setup-step {
    padding: 22px;
    border: 1px solid var(--border-color);
    border-radius: 10px;
    background-color: var(--bg-primary);
  }

  .step-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    margin-bottom: 12px;
    border: 1px solid var(--border-color);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .step-title {
    font-size: 15px;
    font-weight: 600;
    margin-bottom: 6px;
    color: var(--text-primary);
  }

  .step-detail {
    font-size: 13.5px;
    line-height: 1.6;
  }

  .storage-notes {
    margin-top: 40px;
    padding-top: 28px;
    border-top: 1px solid var(--border-color);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .note-item {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .note-icon {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--text-tertiary);
  }

  .note-item strong {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 3px;
  }

  .note-item p {
    font-size: 13.5px;
    line-height: 1.6;
    max-width: 68ch;
  }

  @media (min-width: 800px) {
    .service-grid {
      grid-template-columns: 1fr 1fr;
    }

    .steps-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
