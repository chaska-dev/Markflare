{
  "name": "parasti",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "parasti-db",
      "database_id": "67f8cb91-795f-4e08-9bc9-0596215a21de"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      // TODO(Roki): sesuaikan dengan nama bucket R2 yang kamu buat
      "bucket_name": "parasti-files"
    }
  ],
  // Staging: nama Worker otomatis "parasti-staging". `assets` di atas
  // berlaku juga di sini karena termasuk key yang diwariskan; binding D1/R2
  // TIDAK diwariskan sehingga harus dideklarasikan ulang.
  "env": {
    "staging": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "parasti-staging-db",
          "database_id": "d0311879-c921-4513-a91e-48241457641a"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "parasti-staging-files"
        }
      ]
    }
  }
}
